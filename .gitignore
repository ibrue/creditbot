# Environment variables (contains secrets)
.env
kiosk/.env
tailscale/.env

# Tailscale node identity and keys (never commit)
tailscale/state/

# Database (user data)
*.db
data/

# Kiosk face models (downloaded by kiosk/download_models.py)
kiosk/models/

# Kiosk local face capture log (biometric data - never commit)
kiosk/face_log/

# Queued kiosk check-in photos (deleted after posting - never commit)
kiosk_uploads/

