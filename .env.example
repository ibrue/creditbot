# Discord Bot Token (REQUIRED)
# Get from https://discord.com/developers/applications -> Your App -> Bot -> Token
DISCORD_TOKEN=your-bot-token-here

# Channel IDs (REQUIRED - at least CHECKIN_CHANNEL_ID)
# Enable Developer Mode in Discord: Settings -> App Settings -> Advanced -> Developer Mode
# Then right-click any channel -> Copy ID
CHECKIN_CHANNEL_ID=0
ANNOUNCEMENTS_CHANNEL_ID=0
MEMES_CHANNEL_ID=0
NOTEBOOKING_CHANNEL_ID=0

# Guild (Server) ID (optional - speeds up command sync during testing)
# Right-click your server name -> Copy ID
GUILD_ID=0

# Winner Role ID (optional - set to 0 to auto-create)
# If 0, bot will create "Supreme Leader" role automatically
WINNER_ROLE_ID=0

# Database path (optional - defaults to social_credit.db in same folder)
# When running with docker-compose this is overridden to /data/social_credit.db
# To keep data in your Documents folder instead (folders are created
# automatically; %USERPROFILE% and ~ are expanded):
#DATABASE_PATH=%USERPROFILE%\Documents\CreditBot\social_credit.db
#KIOSK_UPLOADS_DIR=%USERPROFILE%\Documents\CreditBot\checkin_photos
DATABASE_PATH=social_credit.db

# Kiosk API key (REQUIRED for the facial-recognition kiosk)
# Any long random string, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
# The kiosk sends this in the X-API-Key header.
KIOSK_API_KEY=

# ---------------------------------------------------------------------
# Web client (browser check-in at http://<server>:8765/app)
# ---------------------------------------------------------------------
# One shared password for everyone. Anyone who has it can check ANY
# member in or out, so treat it like a door key: pick something long,
# and change it when someone leaves the team.
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
WEB_PASSWORD=

# Set to 0 to turn the web client off entirely (the kiosk API is unaffected).
WEB_ENABLED=1

# The station page (http://<server>:8765/app/station) — for the shared
# desktop. The password alone signs that machine in as this account:
# no picker, no face camera. Point WEB_STATION_ID at an existing
# member's discord_id to reuse an account, or leave the defaults to get
# a dedicated "Lab Computer" account.
WEB_STATION_ID=station
WEB_STATION_NAME=Lab Computer

# Admin page password (http://<server>:8765/app/admin — Discord setup
# GUI + live server terminal). Leave unset to fall back to WEB_PASSWORD.
WEB_ADMIN_PASSWORD=

# Set to 1 when the site is reached over HTTPS, so session cookies are
# marked Secure. Leave 0 for plain http:// over Tailscale or a LAN.
WEB_HTTPS=0

# Set to 1 ONLY if a reverse proxy you control sits in front and sets
# X-Forwarded-For. Otherwise the header is ignored, so a caller cannot
# hand themselves a fresh login rate-limit bucket on every request.
WEB_TRUST_PROXY=0

# Optional. A signing key for session cookies is generated and kept next
# to the database if this is unset, which is fine for a single server.
#WEB_SECRET=

# Timezone for the containers (bonuses like night owl use local time)
TZ=America/Chicago

# Auto-update: pull merged changes from GitHub and restart automatically.
# Requires the project to be a git clone (not a ZIP download).
AUTO_UPDATE=1
UPDATE_BRANCH=main
UPDATE_INTERVAL_MIN=30

# Kiosk check-in photos — the bot posts the kiosk's check-in photo to the
# check-in channel. Set to 0 to disable.
KIOSK_POST_PHOTOS=1

# Local LLM captions for check-in photos (optional, school-friendly)
# Install Ollama from https://ollama.com and run:  ollama pull llava
# (use "moondream" instead of llava on slower PCs)
# Runs fully locally; if Ollama isn't installed, photos post without captions.
OLLAMA_ENABLED=1
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llava
