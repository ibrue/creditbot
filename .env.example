# Discord Bot Token (REQUIRED)
# Get from https://discord.com/developers/applications -> Your App -> Bot -> Token
DISCORD_TOKEN=your-bot-token-here

# Channel IDs (REQUIRED - at least CHECKIN_CHANNEL_ID)
# Enable Developer Mode in Discord: Settings -> App Settings -> Advanced -> Developer Mode
# Then right-click any channel -> Copy ID
CHECKIN_CHANNEL_ID=0
ANNOUNCEMENTS_CHANNEL_ID=0
MEMES_CHANNEL_ID=0
NOTEBOOKING_CHANNEL_ID=0

# Guild (Server) ID (optional - speeds up command sync during testing)
# Right-click your server name -> Copy ID
GUILD_ID=0

# Winner Role ID (optional - set to 0 to auto-create)
# If 0, bot will create "Supreme Leader" role automatically
WINNER_ROLE_ID=0

# Database path (optional - defaults to social_credit.db in same folder)
# When running with docker-compose this is overridden to /data/social_credit.db
DATABASE_PATH=social_credit.db

# Kiosk API key (REQUIRED for the facial-recognition kiosk)
# Any long random string, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
# The kiosk sends this in the X-API-Key header.
KIOSK_API_KEY=

# Timezone for the containers (bonuses like night owl use local time)
TZ=America/Chicago

# Auto-update: pull merged changes from GitHub and restart automatically.
# Requires the project to be a git clone (not a ZIP download).
AUTO_UPDATE=1
UPDATE_BRANCH=main
UPDATE_INTERVAL_MIN=30

# Kiosk check-in photos — the bot posts the kiosk's check-in photo to the
# check-in channel. Set to 0 to disable.
KIOSK_POST_PHOTOS=1

# Local LLM captions for check-in photos (optional, school-friendly)
# Install Ollama from https://ollama.com and run:  ollama pull llava
# (use "moondream" instead of llava on slower PCs)
# Runs fully locally; if Ollama isn't installed, photos post without captions.
OLLAMA_ENABLED=1
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llava
