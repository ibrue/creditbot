# URL of the kiosk API.
# Hosting the bot+API on this same PC (start_server.bat)? Use localhost:
KIOSK_API_URL=http://localhost:8765
# Hosting on a NAS instead? Use its IP, e.g. http://192.168.1.50:8765

# Must match KIOSK_API_KEY in the server's .env
KIOSK_API_KEY=

# Camera index (0 = first webcam)
KIOSK_CAMERA=0

# Start fullscreen (1 = yes)
KIOSK_FULLSCREEN=1

# Auto-update: pull merged changes from GitHub; the kiosk restarts on the
# new version as soon as it's idle. Requires a git clone (not a ZIP).
AUTO_UPDATE=1
UPDATE_BRANCH=main
UPDATE_INTERVAL_MIN=30

# Send the check-in photo to the server so the bot posts it in the
# check-in channel (1 = on). Set 0 to check in without photos.
KIOSK_SEND_PHOTO=1

# Local face capture log — saves recognized/enrollment face crops per person
# so retune_faces.py can improve recognition later. 1 = on (default), 0 = off.
KIOSK_FACE_LOG=1
# Where captures are stored (default: the face_log folder next to kiosk.py)
#KIOSK_FACE_LOG_DIR=C:\creditbot-faces
