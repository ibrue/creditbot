# Copy to tailscale/.env and fill in. tailscale/.env is gitignored — the auth
# key is a credential, don't commit it.

# One-off auth key from https://login.tailscale.com/admin/settings/keys
# ("Generate auth key"). It's only used for the first login; after that the
# node identity lives in tailscale/state/ and the key can expire harmlessly.
# Tick "Reusable" if you plan to tear the container down and re-create it.
TS_AUTHKEY=tskey-auth-REPLACE-ME

# Extra flags passed to `tailscale up`.
#   --hostname sets the name the NAS shows up as in the admin console and
#   over MagicDNS (so: http://creditbot-nas:8765).
TS_EXTRA_ARGS=--hostname=creditbot-nas

# Optional: turn the NAS into a subnet router so tailnet devices can reach
# *other* machines on the lab LAN (the kiosk, the router, printers) by their
# LAN IPs. Leave empty unless you actually want that — it needs a matching
# "Edit route settings" approval in the admin console, and IP forwarding
# enabled on the NAS (setup-tailscale.sh will tell you if it's missing).
# Example: TS_ROUTES=192.168.1.0/24
TS_ROUTES=
